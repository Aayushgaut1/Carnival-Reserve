// Carnival Reserve - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  DOMAIN_MANAGER // 17 Domain Managers (ACC-01 to ACC-17)
  MAGEFFICIE_MANAGER // Marketplace / Spend booth manager (ACC-18)
  SUPER_ADMIN // 2 Super Admins
}

enum TransactionType {
  REGISTRATION_SEED
  PARTICIPATION_CREDIT
  WINNER_CREDIT
  MAGEFFICIE_PURCHASE
  REVERSAL
  AUCTION_HOLD
  AUCTION_SETTLE
  AUCTION_REFUND
}

enum AuctionBidStatus {
  ACTIVE
  OUTBID
  WON
  SETTLED
  CANCELLED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  name             String
  role             Role         @default(PARTICIPANT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  participant      Participant?
  devices          Device[]
  managedTreasury  DomainTreasury?
  transactionsMade Transaction[] @relation("ManagerTransactions")
  redemptionsMade  MagefficieRedemption[] @relation("MagefficieManagerRedemptions")
  adminReviewFlags AdminReviewFlag[] @relation("AdminReviewFlags")

  @@index([role])
}

model Participant {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  regNo            String       @unique
  phone            String
  qrCode           String       @unique // Contains participant_id ONLY

  wallet           Wallet?
  passport         Passport?
  transactions     Transaction[] @relation("ParticipantTransactions")
  redemptions      MagefficieRedemption[]
  adminReviewFlags AdminReviewFlag[]
  auctionBids      AuctionBid[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Wallet {
  id               String       @id @default(uuid())
  participantId    String       @unique
  participant      Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  balance          Int          @default(0) // Derived/tracked balance in Crn
  totalEarned      Int          @default(0)
  totalSpent       Int          @default(0)
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([participantId])
}

model DomainTreasury {
  id          String   @id @default(uuid())
  domainName  String   @unique // 17 festival domains (e.g., Coding & Algo, General Quiz...)
  accountRef  String   @unique // Fixed identifier (e.g., "ACC-01" to "ACC-17")
  active      Boolean  @default(true)
  managerId   String?  @unique
  manager     User?    @relation(fields: [managerId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Passport {
  id            String          @id @default(uuid())
  participantId String          @unique
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  stamps        PassportStamp[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PassportStamp {
  id           String    @id @default(uuid())
  passportId   String
  passport     Passport  @relation(fields: [passportId], references: [id], onDelete: Cascade)
  domainName   String
  claimedAt    DateTime  @default(now())
  isWinner     Boolean   @default(false)

  @@unique([passportId, domainName])
  @@index([passportId])
}

model Transaction {
  id                       String          @id @default(uuid())
  idempotencyKey           String          @unique // Client-generated UUID for deduplication
  amount                   Int
  type                     TransactionType
  
  fromAccountId            String?         // Participant Wallet, DomainTreasury accountRef, or System
  toAccountId              String?         // Participant Wallet, DomainTreasury accountRef, or Magefficie
  
  participantId            String?
  participant              Participant?    @relation("ParticipantTransactions", fields: [participantId], references: [id])
  
  managerId                String?
  manager                  User?           @relation("ManagerTransactions", fields: [managerId], references: [id])
  
  proofPhotoUrl            String?         // Mandatory for WINNER_CREDIT and MAGEFFICIE_PURCHASE
  
  // Reversal Fields
  reversalOfId             String?         @unique // Self-reference unique FK
  reversalOf               Transaction?    @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversedBy               Transaction?    @relation("TransactionReversal")
  reversalWindowExpiresAt  DateTime?
  reason                   String?
  
  timestamp                DateTime        @default(now())
  adminReviewFlags         AdminReviewFlag[]
  
  @@index([idempotencyKey])
  @@index([participantId])
  @@index([managerId])
  @@index([type])
}

model MagefficieRedemption {
  id            String      @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  managerId     String
  manager       User        @relation("MagefficieManagerRedemptions", fields: [managerId], references: [id])
  
  rewardId      String
  quantity      Int         @default(1)
  unitCost      Int
  totalCost     Int
  stockBefore   Int
  stockAfter    Int
  proofRef      String?
  status        String      @default("COMPLETED")
  
  createdAt     DateTime    @default(now())

  @@index([participantId])
  @@index([managerId])
}

model AdminReviewFlag {
  id              String       @id @default(uuid())
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  
  participantId   String
  participant     Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  managerId       String
  manager         User         @relation("AdminReviewFlags", fields: [managerId], references: [id])
  
  reason          String
  currentBalance  Int
  attemptedAmount Int
  status          String       @default("PENDING")
  
  createdAt       DateTime     @default(now())

  @@index([status])
  @@index([participantId])
}

model InventoryItem {
  id             String       @id @default(uuid())
  name           String
  tier           Int          // 1: 100-300, 2: 500-900, 3: 1000-1800, 4: Auction
  price          Int          // Base price or starting bid for Tier 4
  openingCount   Int
  soldCount      Int          @default(0)
  availableCount Int
  reservedCount  Int          @default(0) // Reserved for active auction bids
  imageUrl       String?

  auctionBids    AuctionBid[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tier])
}

model Device {
  id                String   @id @default(uuid())
  managerId         String
  manager           User     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  deviceName        String
  deviceFingerprint String   @unique
  location          String?
  approved          Boolean  @default(false) // Soft tracking for secondary audit
  lastLogin         DateTime @default(now())
  ipAddress         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([managerId])
}

model AuctionBid {
  id            String           @id @default(uuid())
  itemId        String
  item          InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  bidAmount     Int
  status        AuctionBidStatus @default(ACTIVE)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([itemId])
  @@index([participantId])
}
